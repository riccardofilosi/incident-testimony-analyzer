# Copiare in .env e inserire le chiavi. In alternativa le chiavi si impostano
# dall'interfaccia (Impostazioni).

# Chiave principale (usata se GEMINI_API_KEYS è vuoto)
GEMINI_API_KEY=

# Pool multi-chiave: lista CSV di chiavi Gemini.
# Quando popolato, la pipeline distribuisce trascrizione ed estrazione
# sulle chiavi disponibili (rotazione + cooldown su 429).
GEMINI_API_KEYS=

# Cooldown iniziale (s) per una chiave che riceve 429. Cresce ad ogni hit
# consecutivo (60s -> 120s -> 240s ... max 600s).
GEMINI_COOLDOWN_BASE_S=60

GEMINI_MODEL=gemini-3.5-flash
DEFAULT_N_RUNS=5
